# ============================================================
# English Lesson 应用配置文件示例
# 使用方法：复制此文件为 config.yaml 并填入实际值
#   cp config.yaml.example config.yaml
#
# 优先级：环境变量 > config.yaml > 默认值
# ============================================================

# ---- 服务器 ----
server:
  host: "0.0.0.0"
  port: 8000

# ---- 数据库 ----
database:
  path: "english_lesson.db"

# ---- JWT 认证 ----
jwt:
  secret_key: "请替换为随机生成的密钥"
  algorithm: "HS256"
  access_token_expire_minutes: 1440  # 24 小时

# ---- 学习设置 ----
learning:
  default_daily_words: 10

# ---- LLM API ----
llm:
  api_url: "https://api.deepseek.com/v1/chat/completions"
  api_key: "请填入你的 API Key"
  model: "deepseek-chat"

# ---- 邮件 ----
email:
  smtp_server: "smtp.163.com"
  smtp_port: 465
  sender_email: "your_email@163.com"
  sender_password: "请填入邮箱授权码"
  morning_hour: 8
  evening_hour: 21

# ---- 新闻 ----
news:
  fetch_hour: 9
  fetch_count: 20
  retention_days: 7
  list_days: 7
  list_limit: 60
  source_url: "https://www.aibase.com/zh/news/"
  api_url: "https://mcpapi.aibase.cn/api/aiInfo/detail"

# ---- TTS 语音 ----
tts:
  model_path: "checkpoints/kittentts_int8"
  cache_dir: "static/tts_cache"
  default_voice: "Jasper"
  sample_rate: 24000
  max_text_length: 500
